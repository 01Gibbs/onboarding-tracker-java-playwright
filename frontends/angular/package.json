    "@analogjs/vitest-angular": "^2.9.7",
    "@angular/build": "~22.2.7",
    "@angular/cli": "~22.2.7",
    "@angular/compiler-cli": "~22.2.6",
    "@stryker-mutator/core": "^10.1.1",
