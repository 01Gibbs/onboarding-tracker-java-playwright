{
  "name": "e2e-ts",
  "private": true,
  "type": "module",
  "scripts": {
    "test:react": "playwright test --config react/playwright.config.ts",
    "solutions:react": "playwright test --config solutions/playwright.config.ts --project=react",
    "solutions:angular": "playwright test --config solutions/playwright.config.ts --project=angular",
    "contract": "playwright test --config solutions/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "broken:react": "playwright test --config broken/playwright.config.ts --project=react"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "typescript": "~7.0.2"
  }
}
